# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# Payment Provider Configuration (Paystack & Flutterwave)
# Configure production secrets in AI Studio Secrets panel.
PAYMENT_PROVIDER=PAYSTACK
PAYSTACK_PUBLIC_KEY=pk_test_placeholder
PAYSTACK_SECRET_KEY=sk_test_placeholder
PAYSTACK_WEBHOOK_SECRET=pstk_whsec_placeholder
FLUTTERWAVE_PUBLIC_KEY=flw_pub_placeholder
FLUTTERWAVE_SECRET_KEY=flw_sec_placeholder
FLUTTERWAVE_ENCRYPTION_KEY=flw_enc_placeholder

